{
  "name": "dsh-film-analysis",
  "version": "0.3.1",
  "description": "DSH Web UI plugin for film & audiovisual-language analysis: frame metrics, 8-dimension forms, auto shot detection with AI shot breakdowns, annotation, reports and shot lists. Bundled ffmpeg + offline Chinese OCR. UI: zh/English; analysis output in Simplified Chinese.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "film",
    "video-analysis",
    "cinematography",
    "ocr",
    "ffmpeg"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**/*.js",
    "lib/**/*.py",
    "docs/*.md",
    "docs/*.png"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.1.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raven-Jackdaw/dsh-film-analysis.git"
  },
  "homepage": "https://github.com/Raven-Jackdaw/dsh-film-analysis#readme",
  "bugs": {
    "url": "https://github.com/Raven-Jackdaw/dsh-film-analysis/issues"
  }
}
